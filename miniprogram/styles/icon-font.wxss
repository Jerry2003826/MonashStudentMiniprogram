/* 由 scripts/build-icon-font.mjs 生成，不要手改。要加图标请改脚本里的 APP_ICONS。 */
@font-face {
  font-family: 'app-icons';
  src: url('data:font/woff;base64,')
    format('woff');
  font-weight: normal;
  font-style: normal;
}

/* 双重类名是为了盖过 TDesign 自带的 .t-icon { font-family: t !important } */
.t-icon.t-icon {
  font-family: 'app-icons' !important;
}
