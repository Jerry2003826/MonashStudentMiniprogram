.page {
  padding: 24rpx 0 48rpx;
}

.notice {
  margin: 0 var(--spacing-page) 24rpx;
  padding: 16rpx 24rpx;
  color: var(--discount-color);
  font-size: 24rpx;
  background-color: #fff4e5;
  border-radius: 12rpx;
}

.card {
  margin: 0 var(--spacing-page);
  padding: 40rpx 32rpx;
  background-color: var(--bg-color-card);
  border-radius: var(--radius-card);
}

.intro {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.intro__logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand-color), #3aa0d8);
  border-radius: 32rpx;
}

.intro__name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.intro__text {
  margin-top: 20rpx;
  color: var(--text-color-secondary);
  line-height: 1.7;
}

.group {
  display: block;
  margin-top: 24rpx;
}
