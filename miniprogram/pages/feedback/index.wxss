@import '../handbook/index.wxss';

.form,
.result {
  padding: 30rpx;
  background: var(--bg-color-card);
  border-radius: var(--radius-card);
}

.field__label {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.field__hint {
  margin-left: 12rpx;
  color: var(--text-color-placeholder);
  font-size: 24rpx;
  font-weight: 400;
}

.categories {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
  gap: 16rpx 24rpx;
}

.category {
  margin: 0;
  min-height: 72rpx;
  padding: 18rpx 20rpx;
  color: var(--text-color-secondary);
  font-size: 26rpx;
  line-height: 1.5;
  background: var(--bg-color-page);
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.category::after {
  border: none;
}

.category--selected {
  color: var(--brand-color);
  font-weight: 600;
  background: var(--brand-color-light);
  border-color: var(--brand-color);
}

.content-input,
.contact-input {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  background: var(--bg-color-page);
  border-radius: 12rpx;
}

.content-input {
  height: 300rpx;
}

.contact-input {
  height: 92rpx;
}

.counter {
  margin: 10rpx 0 30rpx;
  color: var(--text-color-placeholder);
  font-size: 24rpx;
  text-align: right;
}

.button--primary {
  margin-top: 36rpx;
  color: #ffffff;
  background: var(--brand-color);
}

.button--primary[disabled] {
  color: #ffffff;
  background: var(--brand-color-disabled);
}

.result__title {
  color: var(--brand-color);
  font-size: 34rpx;
  font-weight: 600;
}

.result__description {
  margin-top: 20rpx;
  color: var(--text-color-secondary);
  line-height: 1.8;
}

.result__number {
  margin-top: 20rpx;
  color: var(--text-color-placeholder);
  font-size: 24rpx;
}
