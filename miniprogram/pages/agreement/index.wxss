.page {
  padding: 24rpx var(--spacing-page) 48rpx;
}

.notice {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  color: var(--discount-color);
  font-size: 24rpx;
  background-color: #fff4e5;
  border-radius: 12rpx;
}

.card {
  padding: 32rpx;
  background-color: var(--bg-color-card);
  border-radius: var(--radius-card);
}

.section + .section {
  margin-top: 32rpx;
}

.section__heading {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.section__body {
  color: var(--text-color-secondary);
  font-size: 28rpx;
  line-height: 1.7;
}
