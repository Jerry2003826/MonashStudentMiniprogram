<view wx:if="{{post}}" class="page">
  <view class="card">
    <view class="tags">
      <t-tag wx:if="{{post.is_pinned}}" size="small" theme="danger" variant="light">置顶</t-tag>
      <t-tag size="small" variant="light" theme="primary">{{post.board.name}}</t-tag>
    </view>
    <view class="title">{{post.title}}</view>
    <view wx:if="{{post.moderation_status !== 'approved'}}" class="moderation-notice">
      <text
        >{{post.moderation_status === 'pending' ? '待人工审核，通过后公开展示' :
        '审核未通过'}}</text
      >
      <view wx:if="{{post.review_note}}">{{post.review_note}}</view>
    </view>

    <view class="author">
      <image wx:if="{{post.author.avatar_url}}" class="avatar" src="{{post.author.avatar_url}}" />
      <view wx:else class="avatar avatar--placeholder">
        <t-icon name="user" size="32rpx" />
      </view>
      <view class="author__text">
        <view class="author__name">{{post.author.nickname}}</view>
        <view class="author__time">{{postTime}}</view>
      </view>
      <view class="more" bind:tap="onMore">
        <t-icon name="ellipsis" size="40rpx" />
      </view>
    </view>

    <text class="content" user-select>{{post.content}}</text>

    <view wx:if="{{post.images.length}}" class="images">
      <view
        wx:for="{{post.images}}"
        wx:key="id"
        class="image-cell"
        data-index="{{index}}"
        bind:tap="onPreviewImage"
      >
        <image class="image" src="{{item.url}}" mode="aspectFill" />
        <view wx:if="{{item.check_status === 'pending'}}" class="image-pending">审核中</view>
      </view>
    </view>

    <view wx:if="{{post.moderation_status === 'approved'}}" class="actions">
      <view class="action {{post.liked ? 'action--active' : ''}}" bind:tap="onToggleLike">
        <t-icon name="{{post.liked ? 'thumb-up-filled' : 'thumb-up'}}" size="36rpx" />
        <text>{{post.like_count}}</text>
      </view>
      <view class="action">
        <t-icon name="chat" size="36rpx" />
        <text>{{post.comment_count}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{post.moderation_status === 'approved'}}" class="card comments">
    <view class="comments__title">评论 {{post.comment_count}}</view>
    <view
      wx:for="{{comments}}"
      wx:key="id"
      class="comment"
      hover-class="comment--pressed"
      data-index="{{index}}"
      bind:tap="onReplyComment"
      bind:longpress="onCommentActions"
    >
      <image
        wx:if="{{item.author.avatar_url}}"
        class="comment__avatar"
        src="{{item.author.avatar_url}}"
      />
      <view wx:else class="comment__avatar avatar--placeholder">
        <t-icon name="user" size="24rpx" />
      </view>
      <view class="comment__body">
        <view class="comment__meta">
          <text class="comment__name">{{item.author.nickname}}</text>
          <text class="comment__time">{{item.timeText}}</text>
        </view>
        <view class="comment__content">
          <text wx:if="{{item.reply_to}}" class="comment__reply"
            >回复 @{{item.reply_to.nickname}}：</text
          >
          <text>{{item.content}}</text>
          <view wx:if="{{item.moderation_status !== 'approved'}}" class="moderation-notice">
            {{item.moderation_status === 'pending' ? '评论待审核，暂未公开' : '评论未通过审核'}}
            <view wx:if="{{item.review_note}}">{{item.review_note}}</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{!comments.length && !loadingComments}}" class="comments__empty">
      还没有评论，来说两句吧
    </view>
    <view wx:if="{{loadingComments}}" class="comments__loading">
      <t-loading theme="circular" size="36rpx" />
    </view>
  </view>

  <view wx:if="{{post.moderation_status === 'approved'}}" class="input-bar">
    <view wx:if="{{replyTo}}" class="reply-hint">
      <text>回复 @{{replyTo.nickname}}</text>
      <view class="reply-hint__cancel" bind:tap="onCancelReply">
        <t-icon name="close" size="28rpx" />
      </view>
    </view>
    <view class="input-row">
      <input
        class="input"
        value="{{draft}}"
        placeholder="{{replyTo ? '回复 @' + replyTo.nickname : '说点什么…'}}"
        maxlength="500"
        focus="{{inputFocus}}"
        confirm-type="send"
        bindinput="onDraftInput"
        bindconfirm="onSendComment"
        bindblur="onInputBlur"
      />
      <view class="send {{draft ? '' : 'send--disabled'}}" bind:tap="onSendComment">发送</view>
    </view>
  </view>
</view>

<t-empty
  wx:elif="{{errorMessage}}"
  class="state"
  icon="info-circle"
  description="{{errorMessage}}"
/>

<view wx:else class="state">
  <t-loading theme="circular" size="48rpx" />
</view>
