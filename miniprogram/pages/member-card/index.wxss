page {
  background-color: #0b1f33;
}

.page {
  padding: 56rpx var(--spacing-page);
}

.member-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  height: 420rpx;
  padding: 40rpx;
  overflow: hidden;
  color: #ffffff;
  border-radius: 32rpx;
}

/* 流动的渐变和扫光让卡面一直在动，方便商家分辨实时页面和截图 */
.member-card--active {
  background: linear-gradient(120deg, #006dae, #3aa0d8, #7b5cff, #006dae);
  background-size: 300% 300%;
  box-shadow: 0 20rpx 60rpx rgba(0, 109, 174, 0.45);
  animation: flow 6s ease infinite;
}

.member-card--inactive {
  background: linear-gradient(120deg, #5f6b78, #97a1ad);
}

.member-card__shine {
  position: absolute;
  top: -50%;
  left: -60%;
  width: 40%;
  height: 200%;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0),
    rgba(255, 255, 255, 0.35),
    rgba(255, 255, 255, 0)
  );
  transform: rotate(20deg);
  animation: shine 3s ease-in-out infinite;
}

.member-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-card__org {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.member-card__badge {
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  background-color: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.member-card__user {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.member-card__avatar {
  width: 104rpx;
  height: 104rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
}

.member-card__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
}

.member-card__name {
  font-size: 36rpx;
  font-weight: 600;
}

.member-card__no {
  margin-top: 6rpx;
  font-family: Menlo, monospace;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  opacity: 0.9;
}

.member-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  opacity: 0.95;
}

.member-card__clock {
  display: flex;
  align-items: center;
  font-family: Menlo, monospace;
  font-size: 26rpx;
}

.live-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  background-color: #3ddc84;
  border-radius: 50%;
  animation: pulse 1s ease-in-out infinite;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.empty__title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.hint {
  margin-top: 40rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.action {
  margin-top: 40rpx;
}

@keyframes flow {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

@keyframes shine {
  0% {
    left: -60%;
  }
  60%,
  100% {
    left: 130%;
  }
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}
