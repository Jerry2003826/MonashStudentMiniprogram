.toolbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg-color-card);
}
.search {
  padding: 16rpx var(--spacing-page) 0;
}
.page {
  padding: 24rpx var(--spacing-page) calc(160rpx + env(safe-area-inset-bottom));
}
.example-notice {
  margin-bottom: 20rpx;
  color: var(--text-color-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}
.featured {
  height: 390rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
}
.featured-card {
  box-sizing: border-box;
  height: 100%;
  padding: 28rpx 32rpx 44rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--brand-color), var(--brand-color-active));
}
.featured-card__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  opacity: 0.9;
}
.example-badge {
  padding: 4rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  font-size: 22rpx;
}
.featured-card__title {
  margin-top: 22rpx;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 600;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.featured-card__summary {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  opacity: 0.9;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.featured-card__action {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 24rpx;
}
.section-title {
  margin: 32rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.activity-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius-card);
  background: var(--bg-color-card);
}
.activity-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 68rpx;
  height: 80rpx;
  color: var(--brand-color);
  background: var(--brand-color-light);
  border-radius: 12rpx;
}
.activity-card__body {
  flex: 1;
  min-width: 0;
}
.activity-card__title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: break-word;
}
.inline-badge {
  display: inline-block;
  margin-left: 10rpx;
  padding: 1rpx 8rpx;
  font-size: 20rpx;
  font-weight: normal;
  color: var(--brand-color);
  background: var(--brand-color-light);
  border-radius: 6rpx;
  vertical-align: 3rpx;
}
.activity-card__summary {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--text-color-secondary);
  line-height: 1.5;
}
.activity-card__meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-color-placeholder);
  line-height: 1.5;
}
.pressed {
  opacity: 0.8;
}
.footer,
.error-state {
  padding: 28rpx 0;
  text-align: center;
  color: var(--text-color-secondary);
  font-size: 24rpx;
}
.retry-button {
  margin-top: 20rpx;
  color: var(--brand-color);
  background: var(--brand-color-light);
}
.retry-button::after {
  border: none;
}
