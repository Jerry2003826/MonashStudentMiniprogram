.page {
  padding: 24rpx var(--spacing-page) calc(140rpx + env(safe-area-inset-bottom));
}

.welcome {
  padding: 36rpx 28rpx;
  background: linear-gradient(130deg, var(--brand-color-focus), var(--bg-color-card));
  border-radius: 24rpx;
  animation: enter 350ms ease-out;
}

@keyframes enter {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.welcome__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.welcome__eyebrow {
  color: var(--brand-color);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.welcome__date {
  color: var(--text-color-secondary);
  font-size: 22rpx;
}
.welcome__title {
  margin-top: 28rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.welcome__subtitle {
  margin-top: 12rpx;
  color: var(--text-color-secondary);
  font-size: 26rpx;
}
.welcome__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.welcome__button {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin: 0;
  padding: 16rpx 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--brand-color);
  background: var(--bg-color-card);
  border-radius: 12rpx;
}
.welcome__button::after {
  border: 0;
}
.welcome__button--share {
  background: var(--brand-color);
  color: var(--bg-color-card);
}
.demo-note {
  margin: 20rpx 0;
  color: var(--text-color-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.banner {
  margin-top: 24rpx;
  height: 300rpx;
  overflow: hidden;
  border-radius: var(--radius-card);
}

.banner__item {
  position: relative;
}

.banner__image {
  width: 100%;
  height: 100%;
  background-color: #dfe6ee;
}

.banner__title {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 56rpx 28rpx 28rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.55));
}

.member-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 32rpx;
  color: #ffffff;
  background: var(--brand-gradient);
  border-radius: var(--radius-card);
}

.member-entry--pressed {
  opacity: 0.85;
}

.member-entry__text {
  flex: 1;
  min-width: 0;
}

.member-entry__title {
  font-size: 34rpx;
  font-weight: 600;
}

.member-entry__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.member-entry__action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  margin-left: 24rpx;
  padding: 12rpx 16rpx 12rpx 24rpx;
  font-size: 26rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 0 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
}

.section-more {
  display: flex;
  align-items: center;
  color: var(--text-color-secondary);
  font-size: 26rpx;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
}

.merchant-item {
  display: block;
  margin-bottom: 20rpx;
}

.activity-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--bg-color-card);
  border-radius: var(--radius-card);
}
.activity-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 88rpx;
  border-radius: 12rpx;
  color: var(--brand-color);
  background: var(--brand-color-light);
}
.activity-card__body {
  flex: 1;
  min-width: 0;
}
.activity-card__title {
  font-size: 29rpx;
  font-weight: 600;
}
.activity-card__summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-color-secondary);
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.example-label {
  display: inline-block;
  font-size: 20rpx;
  color: var(--brand-color);
  margin-top: 10rpx;
}
.status-note {
  padding: 28rpx;
  color: var(--text-color-secondary);
  background: var(--bg-color-card);
  border-radius: var(--radius-card);
  font-size: 26rpx;
  line-height: 1.6;
}
.service-grid {
  display: flex;
  gap: 20rpx;
}
.service {
  flex: 1;
  padding: 28rpx 20rpx;
  background: var(--bg-color-card);
  border-radius: var(--radius-card);
}
.service__title,
.service__status {
  display: block;
}
.service__title {
  font-size: 28rpx;
  font-weight: 600;
}
.service__status {
  margin-top: 12rpx;
  color: var(--text-color-secondary);
  font-size: 24rpx;
}
.contact-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  color: var(--brand-color);
  background: var(--brand-color-light);
  border-radius: var(--radius-card);
  font-size: 26rpx;
}
.contact-entry text {
  flex: 1;
}
.card--pressed {
  opacity: 0.75;
}
