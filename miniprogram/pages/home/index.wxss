.page {
  padding: 24rpx var(--spacing-page) 48rpx;
}

.banner {
  height: 300rpx;
  overflow: hidden;
  border-radius: var(--radius-card);
}

.banner__item {
  position: relative;
}

.banner__image {
  width: 100%;
  height: 100%;
  background-color: #dfe6ee;
}

.banner__title {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 56rpx 28rpx 28rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.55));
}

.member-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand-color), #3aa0d8);
  border-radius: var(--radius-card);
}

.member-entry--pressed {
  opacity: 0.85;
}

.member-entry__text {
  flex: 1;
  min-width: 0;
}

.member-entry__title {
  font-size: 34rpx;
  font-weight: 600;
}

.member-entry__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.member-entry__action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  margin-left: 24rpx;
  padding: 12rpx 16rpx 12rpx 24rpx;
  font-size: 26rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 0 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
}

.section-more {
  display: flex;
  align-items: center;
  color: var(--text-color-secondary);
  font-size: 26rpx;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
}

.merchant-item {
  display: block;
  margin-bottom: 20rpx;
}
