.page {
  padding: 48rpx var(--spacing-page) calc(48rpx + env(safe-area-inset-bottom));
}
.hero {
  text-align: center;
  color: var(--brand-color);
  margin-bottom: 36rpx;
}
.title {
  margin-top: 24rpx;
  color: var(--text-color-primary);
  font-size: 38rpx;
  font-weight: 600;
}
.card {
  padding: 32rpx;
  background: var(--bg-color-card);
  border-radius: var(--radius-card);
  font-size: 28rpx;
  line-height: 1.7;
}
.status-title {
  font-size: 32rpx;
  font-weight: 600;
}
.description {
  margin: 16rpx 0;
  color: var(--text-color-secondary);
}
.code {
  margin: 28rpx 0;
  padding: 24rpx 16rpx;
  height: 56rpx;
  font-size: 30rpx;
  text-align: center;
  border: 2rpx solid var(--brand-color-focus);
  border-radius: 12rpx;
}
.warning {
  color: var(--brand-color);
  font-size: 25rpx;
}
.primary,
.secondary {
  margin-top: 28rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}
.primary {
  color: #fff;
  background: var(--brand-color);
}
.secondary {
  color: var(--brand-color);
  background: var(--brand-color-light);
}
.primary::after,
.secondary::after {
  border: none;
}
.demo-note {
  margin-top: 28rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-color-secondary);
}
