<view class="page">
  <view class="hero"
    ><t-icon name="secured" size="72rpx" /><view class="title">确认后台登录</view></view
  >
  <view wx:if="{{confirmed}}" class="card">
    <view class="status-title">登录身份已确认</view>
    <view class="description">请回到刚才的浏览器继续进入管理后台。本页无需再次确认。</view>
  </view>
  <view wx:elif="{{checking}}" class="card">正在检查管理员身份…</view>
  <view wx:elif="{{loadError}}" class="card">
    <view>暂时无法确认管理员身份。</view><button class="secondary" bindtap="load">重新检查</button>
  </view>
  <view wx:elif="{{!allowed}}" class="card">
    <view class="status-title">当前账号没有管理员权限</view>
    <view class="description">请联系学生会负责人配置管理员身份。本页不能自行开通权限。</view>
  </view>
  <view wx:else class="card">
    <view class="description"
      >在你本人正在使用的后台登录网页中获取 6 位确认码，输入后点击下方按钮。</view
    >
    <input
      class="code"
      type="number"
      maxlength="6"
      value="{{code}}"
      disabled="{{submitting}}"
      placeholder="浏览器中的 6 位确认码"
      bindinput="onCodeInput"
    />
    <view class="warning">确认后，该浏览器将以你的管理员身份登录。不要确认他人发来的验证码。</view>
    <button
      class="primary"
      loading="{{submitting}}"
      disabled="{{submitting || code.length !== 6}}"
      bindtap="onConfirm"
    >
      确认登录该浏览器
    </button>
  </view>
  <view wx:if="{{mockMode}}" class="demo-note"
    >开发演示未连接真实浏览器登录会话，也不会自动授予管理员权限。</view
  >
</view>
