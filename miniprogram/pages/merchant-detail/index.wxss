.page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.gallery {
  height: 460rpx;
}

.gallery__image {
  width: 100%;
  height: 100%;
  background-color: #dfe6ee;
}

.card {
  margin: 24rpx var(--spacing-page) 0;
  padding: 32rpx;
  background-color: var(--bg-color-card);
  border-radius: var(--radius-card);
}

.name {
  font-size: 40rpx;
  font-weight: 600;
}

.tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.intro {
  margin-top: 20rpx;
  color: var(--text-color-secondary);
  line-height: 1.6;
}

.discount__title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--discount-color);
  font-size: 34rpx;
  font-weight: 600;
}

.discount__terms {
  margin-top: 16rpx;
  color: var(--text-color-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.discount__how {
  margin-top: 8rpx;
  color: var(--text-color-placeholder);
  font-size: 24rpx;
}

.info {
  display: block;
  margin-top: 24rpx;
}

.copy {
  padding: 8rpx 20rpx;
  color: var(--brand-color);
  font-size: 26rpx;
  border: 1rpx solid var(--brand-color);
  border-radius: 999rpx;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx var(--spacing-page) calc(20rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-color-card);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.state {
  display: flex;
  justify-content: center;
  padding-top: 240rpx;
}
