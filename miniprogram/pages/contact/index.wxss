@import '../handbook/index.wxss';

.contact-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  background: var(--bg-color-card);
  border-radius: var(--radius-card);
}

.contact-card__title {
  font-size: 32rpx;
  font-weight: 600;
}

.contact-card__value {
  display: block;
  margin-top: 20rpx;
  color: var(--brand-color);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.contact-card__description {
  margin-top: 16rpx;
  color: var(--text-color-secondary);
  line-height: 1.7;
}
