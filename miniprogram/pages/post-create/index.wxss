.page {
  padding: 24rpx var(--spacing-page) calc(180rpx + env(safe-area-inset-bottom));
}

.section-title {
  margin-bottom: 16rpx;
  color: var(--text-color-secondary);
  font-size: 26rpx;
}

.boards {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.board-chip {
  padding: 12rpx 28rpx;
  color: var(--text-color-secondary);
  font-size: 26rpx;
  background-color: var(--bg-color-card);
  border: 2rpx solid transparent;
  border-radius: 999rpx;
}

.board-chip--active {
  color: var(--brand-color);
  background-color: var(--brand-color-light);
  border-color: var(--brand-color);
}

.editor {
  overflow: hidden;
  background-color: var(--bg-color-card);
  border-radius: var(--radius-card);
}

.divider {
  height: 1rpx;
  margin: 0 32rpx;
  background-color: #e7e7e7;
}

.upload {
  padding: 0 32rpx 32rpx;
}

.rules {
  margin-top: 24rpx;
  color: var(--text-color-placeholder);
  font-size: 24rpx;
  line-height: 1.6;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx var(--spacing-page) calc(20rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-color-card);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}
