<view class="page">
  <view class="section-title">选择板块</view>
  <view class="boards">
    <view
      wx:for="{{boards}}"
      wx:key="id"
      class="board-chip {{item.id === boardId ? 'board-chip--active' : ''}}"
      data-id="{{item.id}}"
      bind:tap="onBoardTap"
    >
      {{item.name}}
    </view>
  </view>

  <view class="editor">
    <t-input
      placeholder="标题（最多 50 字）"
      value="{{title}}"
      maxlength="{{50}}"
      borderless
      bind:change="onTitleChange"
    />
    <view class="divider" />
    <t-textarea
      placeholder="说点什么吧……"
      value="{{content}}"
      maxlength="{{5000}}"
      indicator
      autosize="{{ { minHeight: 240 } }}"
      bind:change="onContentChange"
    />
  </view>

  <view class="rules"
    >帖子提交后由管理员人工审核，通过后公开。当前支持文字，图片上传暂未开放。请勿发布广告或违规信息。</view
  >

  <view class="action-bar">
    <t-button
      theme="primary"
      size="large"
      block
      loading="{{submitting}}"
      disabled="{{!canSubmit}}"
      bind:tap="onSubmit"
    >
      提交审核
    </t-button>
  </view>
</view>
