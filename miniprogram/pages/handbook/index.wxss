.page {
  padding: 32rpx var(--spacing-page) calc(48rpx + env(safe-area-inset-bottom));
}

.hero {
  margin-bottom: 28rpx;
  padding: 36rpx 32rpx;
  background: var(--brand-color-light);
  border-radius: var(--radius-card);
}

.eyebrow {
  color: var(--brand-color);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero__title {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.45;
}

.hero__description {
  margin-top: 14rpx;
  color: var(--text-color-secondary);
  line-height: 1.7;
}

.notice {
  margin-bottom: 24rpx;
  color: var(--discount-color);
  font-size: 24rpx;
  line-height: 1.6;
}

.section {
  position: relative;
  margin-bottom: 24rpx;
  padding: 30rpx;
  background: var(--bg-color-card);
  border-radius: var(--radius-card);
}

.section__number {
  color: var(--brand-color);
  font-size: 24rpx;
  font-weight: 600;
}

.section__title {
  margin: 12rpx 0 18rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.section__content {
  color: var(--text-color-secondary);
  line-height: 1.85;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.state {
  padding: 48rpx 20rpx;
  color: var(--text-color-secondary);
  text-align: center;
}

.button {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  border-radius: 12rpx;
}

.button::after {
  border: none;
}

.button--secondary {
  color: var(--brand-color);
  background: var(--brand-color-light);
}
