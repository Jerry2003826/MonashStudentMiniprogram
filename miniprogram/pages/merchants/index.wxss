.page-intro {
  padding: 36rpx var(--spacing-page) 28rpx;
  background: linear-gradient(145deg, var(--brand-color-light), var(--bg-color-page));
}

.eyebrow {
  color: var(--brand-color);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.page-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.4;
}

.page-description {
  margin-top: 12rpx;
  color: var(--text-color-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.member-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--brand-color);
  border-radius: var(--radius-card);
  color: white;
  text-align: left;
  line-height: 1.5;
}

.member-entry::after,
.view-action::after,
.privacy-link::after,
.retry-button::after {
  border: 0;
}

.member-entry--pressed {
  opacity: 0.8;
}

.member-entry__copy {
  flex: 1;
  min-width: 0;
}

.member-entry__title {
  font-size: 28rpx;
  font-weight: 600;
}

.member-entry__description {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  overflow-wrap: break-word;
}

.member-entry__action {
  flex-shrink: 0;
  font-size: 24rpx;
}

.toolbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: var(--bg-color-card);
}

.search {
  padding: 16rpx var(--spacing-page) 8rpx;
}

.view-actions,
.privacy-actions {
  display: flex;
  gap: 16rpx;
}

.view-actions {
  padding: 16rpx var(--spacing-page) 20rpx;
}

.view-action {
  flex: 1;
  margin: 0;
  padding: 16rpx 12rpx;
  background: var(--bg-color-page);
  border-radius: 12rpx;
  color: var(--text-color-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.view-action--active {
  background: var(--brand-color-light);
  color: var(--brand-color);
  font-weight: 600;
}

.privacy-card,
.map-panel {
  margin: 24rpx var(--spacing-page) 0;
  overflow: hidden;
  background: var(--bg-color-card);
  border-radius: var(--radius-card);
}

.privacy-card {
  padding: 24rpx;
}

.privacy-title,
.list-heading {
  font-size: 30rpx;
  font-weight: 600;
}

.privacy-description,
.location-message,
.map-caption,
.distance-note {
  color: var(--text-color-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.privacy-description {
  margin-top: 16rpx;
}

.privacy-link {
  margin: 16rpx 0;
  padding: 0;
  background: transparent;
  color: var(--brand-color);
  font-size: 24rpx;
  text-align: left;
  line-height: 1.7;
}

.location-message {
  margin: 24rpx var(--spacing-page) 0;
  padding: 20rpx;
  background: #fff6e8;
  border-radius: 12rpx;
  color: #845813;
}

.merchant-map {
  width: 100%;
  height: 420rpx;
}

.map-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  color: var(--text-color-secondary);
  font-size: 26rpx;
}

.map-caption {
  padding: 20rpx;
}

.map-panel .retry-button {
  margin: 24rpx;
}

.pin-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.pin-card__copy {
  flex: 1;
  min-width: 0;
}

.pin-card__name {
  overflow: hidden;
  color: var(--text-color-primary);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pin-card__meta {
  margin-top: 4rpx;
  color: var(--text-color-secondary);
  font-size: 22rpx;
}

.pin-card__discount {
  margin-top: 8rpx;
  color: var(--discount-color);
  font-size: 24rpx;
}

.pin-card__action {
  flex-shrink: 0;
  color: var(--brand-color);
  font-size: 24rpx;
}

.list {
  padding: 24rpx var(--spacing-page) 48rpx;
}

.distance-note {
  margin: 8rpx 0 24rpx;
}

.retry-button {
  padding: 20rpx;
  background: var(--brand-color-light);
  border-radius: 12rpx;
  color: var(--brand-color);
  font-size: 26rpx;
  line-height: 1.5;
}

.merchant-item {
  display: block;
  margin-bottom: 20rpx;
}

.footer {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
  color: var(--text-color-placeholder);
  font-size: 24rpx;
}
