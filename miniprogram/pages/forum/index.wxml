<view class="toolbar">
  <view class="search">
    <t-search
      value="{{keyword}}"
      shape="round"
      placeholder="搜索帖子标题和内容"
      bind:submit="onSearch"
      bind:clear="onClearSearch"
    />
  </view>
  <t-tabs value="{{board}}" space-evenly="{{false}}" bind:change="onTabChange">
    <t-tab-panel label="全部" value="{{0}}" />
    <t-tab-panel wx:for="{{boards}}" wx:key="id" label="{{item.name}}" value="{{item.id}}" />
  </t-tabs>
</view>

<view class="list">
  <post-card wx:for="{{items}}" wx:key="id" class="post-item" post="{{item}}" />
  <view wx:if="{{loadFailed}}" class="load-error">
    <text>帖子暂时无法加载，请稍后重试</text>
    <t-button theme="primary" variant="outline" size="small" bind:tap="onRetry">重新加载</t-button>
  </view>
  <t-empty
    wx:if="{{loaded && !items.length && !loadFailed}}"
    icon="chat"
    description="这里还没有帖子，来发第一条吧"
  />
  <view wx:if="{{loading}}" class="footer">
    <t-loading theme="circular" size="40rpx" text="加载中" />
  </view>
  <view wx:elif="{{loaded && items.length && !hasMore}}" class="footer">没有更多帖子了</view>
</view>

<t-fab
  icon="add"
  text="发帖"
  style="right: 32rpx; bottom: calc(132rpx + env(safe-area-inset-bottom))"
  bind:click="onCreatePost"
/>
