.toolbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: var(--bg-color-card);
}

.search {
  padding: 16rpx var(--spacing-page) 0;
}

.list {
  padding: 24rpx var(--spacing-page) 160rpx;
}

.post-item {
  display: block;
  margin-bottom: 20rpx;
}

.load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx 0;
  color: var(--text-color-secondary);
  font-size: 28rpx;
}

.footer {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
  color: var(--text-color-placeholder);
  font-size: 24rpx;
}
