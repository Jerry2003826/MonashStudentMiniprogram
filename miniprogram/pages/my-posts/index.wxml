<view class="page">
  <post-card wx:for="{{items}}" wx:key="id" class="post-item" post="{{item}}" />

  <view wx:if="{{loadFailed}}" class="load-error">
    <text>帖子暂时无法加载，请稍后重试</text>
    <t-button theme="primary" variant="outline" size="small" bind:tap="loadMore">重新加载</t-button>
  </view>

  <view wx:if="{{loaded && !items.length && !loadFailed}}" class="empty">
    <t-empty icon="chat" description="你还没有发过帖子" />
    <view class="empty__action">
      <t-button theme="primary" variant="outline" bind:tap="onCreatePost">去发帖</t-button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="footer">
    <t-loading theme="circular" size="40rpx" text="加载中" />
  </view>
  <view wx:elif="{{loaded && items.length && !hasMore}}" class="footer">没有更多了</view>
</view>
