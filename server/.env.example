# Local development only. Copy to .env and load these variables in your shell.
# Django does not automatically read .env.
DJANGO_DEBUG=true
ENABLE_DEV_LOGIN=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Real WeChat login never falls back to local demonstration identities.
WECHAT_APPID=
WECHAT_APPSECRET=
# Production content moderation uses the WeChat server API. fake is accepted only
# with both local development switches enabled, and services require loopback.
WECHAT_CONTENT_SAFETY_MODE=wechat

# Blank is allowed only with DJANGO_DEBUG=true and uses var/db.sqlite3.
# Production requires PostgreSQL plus a strong unique DJANGO_SECRET_KEY,
# WECHAT_APPID / WECHAT_APPSECRET and explicit allowed hosts.
# Percent-encode reserved characters in database usernames/passwords.
# Remote PostgreSQL defaults to sslmode=require; only explicit loopback/socket hosts
# may use sslmode=disable (for example a locally running Cloud SQL Auth Proxy).
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/student_union?sslmode=disable
# Supported URL options: sslmode, sslrootcert (absolute CA path or system),
# connect_timeout (positive seconds), host (absolute Unix socket directory).
# Provider examples are in env/supabase.env.example and env/cloudsql.env.example.
DATABASE_URL=
DB_CONN_MAX_AGE=60
# direct/session retain normal PostgreSQL behavior. transaction disables server-side
# cursors and prepared statements; use direct/session for migration/transfer commands.
DB_POOL_MODE=direct

# HTTPS terminates at the deployment ingress. Turn this on only when that proxy
# strips client X-Forwarded-Proto headers and supplies its own trusted value.
DJANGO_TRUST_PROXY_SSL_HEADER=false
# Defaults: true outside DEBUG, false during local development.
# DJANGO_SECURE_SSL_REDIRECT=true
# Start with one hour; extend after verifying HTTPS for the deployment domain.
# DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Portable container/Gunicorn process options. No migration or seed runs on boot.
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

# Debug default writes generated codes to var/emails; no email is sent.
# Production always defaults to SMTP and rejects console/file delivery backends.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@localhost
MEMBERSHIP_ALLOWED_EMAIL_DOMAINS=student.monash.edu

# Required when the browser portal is served through a different trusted HTTPS origin.
# CSRF_TRUSTED_ORIGINS=https://admin.example.org
CSRF_TRUSTED_ORIGINS=
