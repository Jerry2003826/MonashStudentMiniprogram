# Copy to server/.env.staging (gitignored), chmod 600, and fill actual service values.
# No placeholder is a usable credential. ops.preflight rejects this template.
DJANGO_DEBUG=false
ENABLE_DEV_LOGIN=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
PUBLIC_API_ORIGIN=
CSRF_TRUSTED_ORIGINS=

# Enable only behind the trusted platform HTTPS proxy which replaces forwarding headers.
DJANGO_TRUST_PROXY_SSL_HEADER=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Must match project.config.json. AppSecret is server-only.
WECHAT_APPID=wxb78bc0898b0d8c1c
WECHAT_APPSECRET=
WECHAT_CONTENT_SAFETY_MODE=wechat

# Use a dedicated Supabase staging project, Data API disabled, session pooler + TLS.
# See env/supabase.env.example (or cloudsql.env.example for the Google alternative).
DATABASE_URL=
DB_POOL_MODE=session
DB_CONN_MAX_AGE=0

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
MEMBERSHIP_ALLOWED_EMAIL_DOMAINS=student.monash.edu

# Start small: four threads per instance; cap Cloud Run instances separately.
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
PORT=8080
