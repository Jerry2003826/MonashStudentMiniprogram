# Google Cloud SQL for PostgreSQL, through a separately configured Cloud SQL Auth Proxy.
# This application does not install or start the proxy and needs no provider SDK.
# Merge with the required application and SMTP environment; provision the database/user first.

# Local TCP proxy: sslmode=disable applies only to the loopback client-to-proxy hop.
# The Cloud SQL Auth Proxy provides IAM authorization and encrypts its upstream connection.
DATABASE_URL='postgresql://APP_DB_USER:REPLACE_WITH_PERCENT_ENCODED_PASSWORD@127.0.0.1:5433/APP_DATABASE?sslmode=disable&connect_timeout=5'
DB_POOL_MODE=direct
DB_CONN_MAX_AGE=60

# Unix socket alternative: the query host is the socket directory, not the .s.PGSQL file.
# Replace PROJECT_ID:REGION:INSTANCE_NAME with the actual instance connection name.
# DATABASE_URL='postgresql://APP_DB_USER:REPLACE_WITH_PERCENT_ENCODED_PASSWORD@/APP_DATABASE?host=%2Fcloudsql%2FPROJECT_ID%3AREGION%3AINSTANCE_NAME&sslmode=disable&connect_timeout=5'

# A direct remote TCP connection must use TLS (require/verify-ca/verify-full).
# Use the database's verified host and CA configuration from your deployment runbook.
# DATABASE_URL='postgresql://APP_DB_USER:REPLACE_WITH_PERCENT_ENCODED_PASSWORD@VERIFIED_DATABASE_HOST:5432/APP_DATABASE?sslmode=verify-full&sslrootcert=%2Frun%2Fsecrets%2Fcloudsql-ca.pem'
