# Database-only settings; merge with the required application and SMTP environment.
# Copy the connection details from the project's Supabase dashboard.
# Percent-encode the real username/password, including @ : / # ? % characters.
# Do not paste credentials into logs or commit the completed environment file.

# Persistent server with IPv6 connectivity: direct connection.
DATABASE_URL='postgresql://postgres:REPLACE_WITH_PERCENT_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require'
DB_POOL_MODE=direct
DB_CONN_MAX_AGE=60

# IPv4-only server: use the dashboard's session pooler host on port 5432.
# The pooler username includes the project reference; do not reuse the direct username.
# DATABASE_URL='postgresql://postgres.PROJECT_REF:REPLACE_WITH_PERCENT_ENCODED_PASSWORD@POOLER_HOST_FROM_DASHBOARD:5432/postgres?sslmode=require'
# DB_POOL_MODE=session

# Transaction pooling is opt-in and is not suitable for database transfer commands.
# Use the dashboard's transaction pooler details (typically port 6543).
# DB_POOL_MODE=transaction disables server-side cursors and prepared statements.
# It does not enable support for session state, temporary tables, or session-level SET.
# DATABASE_URL='postgresql://postgres.PROJECT_REF:REPLACE_WITH_PERCENT_ENCODED_PASSWORD@POOLER_HOST_FROM_DASHBOARD:6543/postgres?sslmode=require'
# DB_POOL_MODE=transaction

# If using a verified CA, mount it and prefer verify-full; paths must be absolute.
# DATABASE_URL='postgresql://postgres:REPLACE_WITH_PERCENT_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=%2Frun%2Fsecrets%2Fsupabase-ca.pem'
